# Copy to .env.local for local dev. For Cloudflare Pages, set the same keys in the dashboard.
# NOTE: Only NEXT_PUBLIC_* vars are available to the browser. Everything else is
# server-side only (Cloudflare Pages Functions / local scripts) and must NOT use a
# NEXT_PUBLIC_ prefix.

# Optional: override site URL for form redirects (defaults to https://brandverse.tech)
# NEXT_PUBLIC_SITE_URL=https://brandverse.tech

# AI API Configuration (server-side)
GOOGLE_GENERATIVE_AI_API_KEY=your_google_gemini_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Analytics & Tracking (public)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=your_meta_pixel_id
NEXT_PUBLIC_COOKIEBOT_ID=your_cookiebot_id
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=your_linkedin_partner_id
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_search_console_token

# Scheduling & Contact (public)
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-username/30min

# Voice AI - public demo key + assistant id used by /demos/voice
# Backend credentials (VAPI_API_KEY / VAPI_PHONE_NUMBER) stay server-side.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=your_vapi_public_key_here
NEXT_PUBLIC_VAPI_ASSISTANT_ID=your_vapi_assistant_id_here
VAPI_API_KEY=your_vapi_api_key_here
VAPI_PHONE_NUMBER=+1your-phone-number-here

# Lead capture -> Google Sheets via Apps Script webhook (server-side)
GOOGLE_APPS_SCRIPT_WEBHOOK_URL=your_apps_script_webhook_url_here
GOOGLE_APPS_SCRIPT_SECRET=your_shared_secret_here

# Mailchimp (server-side only — proxied through the Pages Function)
MAILCHIMP_API_KEY=your_mailchimp_api_key_here
MAILCHIMP_AUDIENCE_ID=your_mailchimp_audience_id_here

# Web push (server-side; only set if you implement push delivery)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
# Server-only VAPID and admin secret for the push endpoints:
# VAPID_PRIVATE_KEY=your_vapid_private_key_here
# VAPID_PUBLIC_KEY=your_vapid_public_key_b64_here
# ADMIN_PUSH_PASSWORD=strong_random_secret

# AI reception Worker (edge) secrets: set via `wrangler secret put` or Pages env.
# See ai-reception/wrangler.toml for the full list.

# Forms: all public marketing forms POST to FormSubmit → ayush@brandverse.tech (see lib/forms.ts).
# First time only: submit a test form, then confirm the address in the email FormSubmit sends you.